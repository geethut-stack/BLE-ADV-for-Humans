<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/t_minus"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_btn_off"
        android:gravity="center"
        android:text="−"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/t_value"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="5 min"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/t_plus"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_btn_off"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/t_start"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_btn_on"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/timer_start_short"
        android:textColor="#1C1C1E"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
